{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "3e0f1f0e-6c6a-4f43-9a3c-0b8f5d2b7e11"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "DeliveryApi": {
        "Enabled": false
      },
      "Imaging": {
        "HMACSecretKey": "Iq57ItIfoXd5pcKih2gCnDBuGJ8/ZAus/p3dqoJonm2N9HX20L7P1QN2Y1wg4zW\u002BCqYlndsO6C9WXyNyf8lscg=="
      }
    },
    "AI": {
      "DefaultEmbeddingProfileAlias": "starter-embedding",
      "Search": {
        "ChunkSize": 384,
        "ChunkOverlap": 50,
        "DefaultTopK": 100,
        "MinScore": 0.35
      }
    }
  },
  "Site": {
    "Name": "Umbraco AI Starterkit"
  },
  "Seed": {
    "Enabled": true,
    "StarterContent": true
  },
  "AiSetup": {
    "ChatModel": "gpt-6.2-sol",
    "EmbeddingModel": "text-embedding-3-small"
  },
  "SiteSearch": {
    "MaxContentResults": 10,
    "CacheSeconds": 300,
    "RequestsPerMinute": 30
  }
}