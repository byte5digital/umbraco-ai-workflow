@inherits UmbracoViewPage
@{
    Layout = "master.cshtml";
    SiteContext site = SiteResolver.For(Model.Root(), Context.Request, ViewExtensions.CurrentCulture());
    string? query = Context.Request.Query["q"];
}
@await Html.PartialAsync("site/breadcrumb", Model)
<section class="container mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">@Model.Name(site.Culture)</h1>
    <form class="mt-6 flex gap-2" method="get" role="search">
        <label class="sr-only" for="search-query">@Umbraco.Ui(UiTexts.Search)</label>
        <input id="search-query" name="q" type="search" value="@query" minlength="2" maxlength="120" required
               placeholder="@Umbraco.Ui(UiTexts.SearchPlaceholder)"
               class="flex-1 rounded-md border border-slate-300 px-4 py-2 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-200" />
        <button type="submit" class="rounded-md bg-brand-700 px-5 py-2 font-semibold text-white hover:bg-brand-800">@Umbraco.Ui(UiTexts.Search)</button>
    </form>
    @await Component.InvokeAsync("SearchResults", new { site, query })
</section>
@await Html.GetBlockGridHtmlAsync(Model, Props.MainContent)