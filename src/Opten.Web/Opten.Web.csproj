<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Opten.Web</RootNamespace>
    <!-- Backoffice files are precompressed by Umbraco – do not let dotnet compress them again -->
    <CompressionEnabled>false</CompressionEnabled>
    <UserSecretsId>opten-umbraco-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Opten.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" />
    <PackageReference Include="Umbraco.AI" />
    <PackageReference Include="Umbraco.AI.OpenAI" />
    <PackageReference Include="Umbraco.AI.Prompt" />
    <PackageReference Include="Umbraco.AI.Agent" />
    <PackageReference Include="Umbraco.AI.Agent.Copilot" />
    <PackageReference Include="Umbraco.AI.Search" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      App-local ICU for consistent globalization across platforms (Umbraco default): enabled unless building on macOS
      without an explicit RuntimeIdentifier. Keep UmbracoAppLocalIcuVersion in sync with Directory.Packages.props.
    -->
    <UmbracoUseAppLocalIcu Condition="'$(UmbracoUseAppLocalIcu)' == '' and ($(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx'))))">true</UmbracoUseAppLocalIcu>
    <UmbracoUseAppLocalIcu Condition="'$(UmbracoUseAppLocalIcu)' == ''">false</UmbracoUseAppLocalIcu>
    <UmbracoAppLocalIcuVersion Condition="'$(UmbracoAppLocalIcuVersion)' == ''">72.1.0.3</UmbracoAppLocalIcuVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UmbracoUseAppLocalIcu)' == 'true'">
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="$(UmbracoAppLocalIcuVersion)" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Seed images are imported into the media library on first start (optional) -->
    <None Include="SeedData/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Tailwind source is compiled to wwwroot/css/site.css, never served directly -->
    <Content Remove="Styles/**" />
    <None Include="Styles/**" />
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!--
    Tailwind CSS: compiled before every build when node_modules exists (npm install in the repo root).
    CI runs "npm run build:css" explicitly and passes -p:SkipTailwind=true.
  -->
  <Target Name="BuildTailwind" BeforeTargets="Build"
          Condition="'$(SkipTailwind)' != 'true' and Exists('$(MSBuildProjectDirectory)/../../node_modules')">
    <Exec Command="npm run build:css --silent" WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
  </Target>
</Project>
