# ─────────────────────────────────────────────────────────────────────────────
# Umbraco AI Starterkit – environment variables
# Copy to .env and adjust:  cp .env.example .env
#
# Everything here is a working LOCAL DEVELOPMENT default – except LLM API keys, which stay empty and
# are only ever set in your local .env (or as CI/server secrets). Staging/production get their own values.
#
# Keys use the ASP.NET Core convention: "__" = section separator
# (Umbraco__CMS__Global__Id ⇔ appsettings.json Umbraco:CMS:Global:Id).
# Locally the app loads .env itself (src/UmbracoAI.Web/Configuration/DotEnvFile.cs),
# Docker Compose passes it via env_file. Real environment variables always win.
# NEVER commit .env – it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# --- Unattended install: creates the database and the first backoffice admin on first start ---
Umbraco__CMS__Unattended__InstallUnattended=true
Umbraco__CMS__Unattended__UnattendedUserName=Administrator
Umbraco__CMS__Unattended__UnattendedUserEmail=admin@example.local
# Min. 10 characters
Umbraco__CMS__Unattended__UnattendedUserPassword=ChangeMe!Umbraco2026

# --- Database (optional) ---
# Default: SQLite in src/UmbracoAI.Web/umbraco/Data (see appsettings.json) – nothing to configure.
# SQL Server instead (e.g. docker compose --env-file .env -f docker/docker-compose.yml -f docker/docker-compose.sqlserver.yml):
# ConnectionStrings__umbracoDbDSN=Server=localhost,14330;Database=UmbracoAIStarterkit;User Id=sa;Password=ChangeMe!Db2026;TrustServerCertificate=True
# ConnectionStrings__umbracoDbDSN_ProviderName=Microsoft.Data.SqlClient

# --- Site & seeding ---
Site__Name=Umbraco AI Starterkit
# Seeds languages, content model (document types, Block Grid), dictionary and AI setup
Seed__Enabled=true
# Bilingual starter pages (only on an empty content tree). false = content model only
Seed__StarterContent=true

# --- Umbraco AI (official Umbraco.AI packages, OpenAI provider) ---
# Connection, profiles, brand voice, prompts, Copilot and the semantic search are set up once a key is set.
# The key is only referenced by the connection ("$Umbraco:AI:Secrets:OpenAIApiKey") – never stored in the database.
Umbraco__AI__Secrets__OpenAIApiKey=
AiSetup__ChatModel=gpt-6.2-sol
AiSetup__EmbeddingModel=text-embedding-3-small

# --- Umbraco Developer MCP (@umbraco-cms/mcp-dev, used by Claude Code via .mcp.json) ---
# Creates the API user "Umbraco MCP" (client id umbraco-back-office-mcp) on start – ONLY in the Development
# environment (the value below is public). Own value: openssl rand -hex 32
McpApiUser__ClientSecret=local-dev-mcp-secret-9f3c2a7e5b1d4c8a
# URL the MCP server talks to (dotnet run: https://localhost:44380, Docker: http://localhost:8080)
UMBRACO_MCP_BASE_URL=https://localhost:44380

# --- Docker only ---
WEB_PORT=8080
# Docker runs plain HTTP on localhost – allows the backoffice login without TLS. NEVER enable in production.
LocalDev__AllowHttpBackoffice=false
# SQL Server profile (docker-compose.sqlserver.yml)
DB_SA_PASSWORD=ChangeMe!Db2026
